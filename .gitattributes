# ==================================================================
# Reveille -- Git attributes
#
# The entry with real teeth is the first one. Without it, a checkout on
# Windows and a checkout on Linux produce different bytes for the same
# commit, and every cross-platform contributor generates whole-file
# diffs that bury the actual change.
# ==================================================================

# Normalise all text to LF in the repository, regardless of platform.
# Git detects which files are text; the explicit entries below override
# that detection where guessing wrong would be costly.
* text=auto eol=lf

# ------------------------------------------------------------------
# Explicitly text
# ------------------------------------------------------------------

*.py        text diff=python
*.pyi       text diff=python
*.j2        text
*.md        text diff=markdown
*.toml      text
*.yml       text
*.yaml      text
*.json      text
*.cfg       text
*.ini       text
*.txt       text
*.html      text diff=html
*.css       text diff=css
*.js        text
.gitignore  text
.gitattributes text
.editorconfig  text
Makefile    text

# Shell scripts must keep LF even if a tool is configured otherwise --
# CRLF makes them unexecutable.
*.sh        text eol=lf

# ------------------------------------------------------------------
# Generated lock files -- never merge textually
#
# `poetry.lock` is machine-generated TOML with no meaningful line-level
# semantics. On 2026-09-02 a merge of a plotly upgrade into `main`
# conflicted inside plotly's `[package.extras]` table -- one side listed
# four extras, the other five. Git raised the conflict correctly. It was
# then resolved by removing the conflict markers and keeping *both*
# blocks, which duplicated four keys.
#
# Duplicate keys are a TOML syntax error. `poetry install` stopped
# working entirely, and CI failed on six consecutive merges to `main`.
#
# The failure mode is specific: for a generated file, "keep both sides"
# is never a valid resolution, but it is the most natural gesture in a
# conflict editor. Unsetting `merge` removes that gesture. Git no longer
# writes conflict markers into this file -- it keeps the current
# branch's version and declares the merge conflicted -- so there is no
# marker to delete and no way to hand-merge. The only way forward is to
# regenerate the file with the tool that owns it:
#
#     poetry lock --no-update
#
# See gitattributes(5), "Performing a three-way merge", `merge` unset.
# This is a guard against a human editing action, not against Git.
# ------------------------------------------------------------------

poetry.lock     text -merge

# ------------------------------------------------------------------
# Explicitly binary -- never normalise, never diff
# ------------------------------------------------------------------

*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.woff      binary
*.woff2     binary
*.gz        binary
*.zip       binary
*.whl       binary

# ------------------------------------------------------------------
# Language statistics
#
# The repository is Python. Without these, the vendored Plotly bundle in
# generated reports and the report template's inline CSS/JS would have
# GitHub reporting this as a JavaScript project.
# ------------------------------------------------------------------

*.j2                    linguist-language=HTML
docs/**                 linguist-documentation
tests/**                linguist-language=Python

# ------------------------------------------------------------------
# Excluded from source archives (`git archive`)
# ------------------------------------------------------------------

.github/        export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
tests/          export-ignore
