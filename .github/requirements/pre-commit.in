# pre-commit for the CI job that runs actionlint and the hygiene hooks, outside
# the project's own dependency graph. `pre-commit.txt` pins it and everything it
# pulls in by version and hash, as `sbom.txt` does for the SBOM generator.
# Regenerate it after changing this file, from this directory:
#
#   pip-compile --generate-hashes --strip-extras --allow-unsafe pre-commit.in
pre-commit==4.7.0
