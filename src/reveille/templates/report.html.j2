<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ data.metadata.name }} — Reveille Report</title>
    <style>
        /* ============================================================
           Custom Properties — Light Theme (default)
           ============================================================ */
        :root {
            --color-bg:              #ffffff;
            --color-surface:         #f6f8fa;
            --color-surface-raised:  #ffffff;
            --color-border:          #d1d9e0;
            --color-border-subtle:   #eaeef2;
            --color-text-primary:    #1c2128;
            --color-text-secondary:  #57606a;
            --color-text-muted:      #69717a;
            --color-primary:         #1e40af;
            --color-primary-dim:     #dbeafe;
            --color-accent:          #2563eb;
            --color-positive:        #1a7f37;
            --color-negative:        #cf222e;

            --color-tier-7: #24292f;
            --color-tier-6: #1e3a8a;
            --color-tier-5: #1d4ed8;
            --color-tier-4: #0e7490;
            --color-tier-3: #15803d;
            --color-tier-2: #b45309;
            --color-tier-1: #57606a;
            --color-tier-ink: #ffffff;
        }

        /* ============================================================
           Custom Properties — Dark Theme
           ============================================================ */
        [data-theme="dark"] {
            --color-bg:              #0d1117;
            --color-surface:         #161b22;
            --color-surface-raised:  #21262d;
            --color-border:          #30363d;
            --color-border-subtle:   #21262d;
            --color-text-primary:    #e6edf3;
            --color-text-secondary:  #8b949e;
            --color-text-muted:      #868f99;
            --color-primary:         #58a6ff;
            --color-primary-dim:     #1f3458;
            --color-accent:          #79c0ff;
            --color-positive:        #3fb950;
            --color-negative:        #f85149;

            /* A filled badge on a dark page cannot carry white text: the
               fill must be dark enough for white to read on it, and light
               enough to be visible against the page, and those pull apart.
               Measured on the previous set: white on tier-3 was 3.30:1 and
               the tier-6 fill was 2.17:1 against the page -- six of seven
               failed one bound or the other. Dark text on a light fill
               satisfies both, and is the ordinary treatment for a badge on
               a dark surface. `--color-tier-ink` carries that text colour;
               the light theme keeps white. */
            --color-tier-7: #8b949e;
            --color-tier-6: #6ea8fe;
            --color-tier-5: #79c0ff;
            --color-tier-4: #39c5cf;
            --color-tier-3: #3fb950;
            --color-tier-2: #e3a008;
            --color-tier-1: #8b949e;
            --color-tier-ink: #0d1117;
        }

        /* ============================================================
           Reset and Base
           ============================================================ */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family:
                -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
                'Helvetica Neue', Arial, sans-serif;
            font-size: 14px;
            line-height: 1.6;
            color: var(--color-text-primary);
            background: var(--color-bg);
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        .page {
            max-width: 1280px;
            margin: 0 auto;
            padding: 40px 40px 80px;
        }

        /* ============================================================
           Header
           ============================================================ */
        .report-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 24px;
            border-bottom: 2px solid var(--color-primary);
            padding-bottom: 24px;
            margin-bottom: 36px;
        }

        .report-header-copy h1 {
            font-size: 22px;
            font-weight: 700;
            letter-spacing: -0.4px;
            line-height: 1.2;
            color: var(--color-text-primary);
        }

        .report-subtitle {
            margin-top: 4px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.9px;
            color: var(--color-text-muted);
        }

        .report-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 12px;
            font-size: 12px;
            color: var(--color-text-secondary);
        }

        .report-meta span strong {
            font-weight: 600;
            color: var(--color-text-primary);
        }

        /* ============================================================
           Theme Toggle
           ============================================================ */
        .theme-toggle {
            flex-shrink: 0;
            margin-top: 2px;
            padding: 6px 14px;
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 4px;
            color: var(--color-text-secondary);
            font-family: inherit;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            cursor: pointer;
            white-space: nowrap;
            transition:
                background-color 0.15s ease,
                color 0.15s ease,
                border-color 0.15s ease;
        }

        .theme-toggle:hover {
            background: var(--color-primary-dim);
            border-color: var(--color-primary);
            color: var(--color-primary);
        }

        /* ============================================================
           Summary Cards
           ============================================================ */
        .summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(148px, 1fr));
            gap: 12px;
            margin-bottom: 44px;
        }

        .summary-card {
            padding: 16px 18px 18px;
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 6px;
        }

        .summary-card .value {
            font-size: 26px;
            font-weight: 700;
            line-height: 1.1;
            letter-spacing: -0.5px;
            color: var(--color-primary);
            font-variant-numeric: tabular-nums;
        }

        .summary-card .label {
            margin-top: 6px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            color: var(--color-text-muted);
        }

        /* ============================================================
           Sections
           ============================================================ */
        .section {
            margin-bottom: 48px;
        }

        .section-note {
            margin: -6px 0 18px;
            max-width: 78ch;
            color: var(--color-text-secondary);
            font-size: 12.5px;
            line-height: 1.6;
        }

        /* A single figure carried on the section heading, for a number that
           belongs to the whole section rather than to one series. The Lorenz
           curve's Gini used to be the chart's own title, anchored top-left,
           which is where Plotly also anchors the legend -- the two overlapped
           in every export. */
        .section-metric {
            margin-left: auto;
            font-size: 12px;
            font-weight: 400;
            letter-spacing: 0.02em;
            color: var(--color-text-secondary);
            white-space: nowrap;
        }

        .section-metric b {
            font-variant-numeric: tabular-nums;
            font-size: 15px;
            font-weight: 600;
            color: var(--color-text-primary);
        }

        /* Method and caveat, under the chart it qualifies rather than above
           it. A reader looking for the finding should reach the chart first;
           a reader questioning the finding needs this, and knows to look. */
        .findings {
            list-style: none;
            margin: 0 0 4px;
            padding: 0;
            display: grid;
            gap: 1px;
            background: var(--color-border);
            border: 1px solid var(--color-border);
        }

        .findings li {
            background: var(--color-surface-raised);
            padding: 14px 16px;
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 2px 16px;
            align-items: baseline;
        }

        .finding-head {
            font-size: 14px;
            font-weight: 600;
            color: var(--color-text-primary);
        }

        .finding-evidence {
            font-variant-numeric: tabular-nums;
            font-size: 11.5px;
            letter-spacing: 0.02em;
            color: var(--color-text-muted);
            white-space: nowrap;
        }

        .finding-detail {
            grid-column: 1 / -1;
            font-size: 12.5px;
            line-height: 1.55;
            color: var(--color-text-secondary);
        }

        @media (max-width: 640px) {
            .findings li { grid-template-columns: 1fr; }
            .finding-evidence { grid-column: 1; }
        }

        /* Repository profile. A table with bars in its cells, not a chart:
           length from a common baseline is the most accurately read encoding
           (Cleveland & McGill, JASA 1984), and unlike the radar it survives
           JavaScript being off. One neutral fill throughout -- a severity ramp
           would say some values are bad, and none of these measures is a
           target. */
        .profile-flower {
            margin: 0 auto 8px;
            max-width: 400px;
        }

        .profile-flower svg {
            display: block;
            width: 100%;
            height: auto;
            overflow: visible;
        }

        .profile-flower figcaption {
            text-align: center;
            font-size: 11.5px;
            color: var(--color-text-muted);
        }

        .flower-grid {
            fill: none;
            stroke: var(--color-border);
            stroke-dasharray: 2 3;
        }

        .flower-track {
            fill: var(--color-surface);
            stroke: var(--color-border);
        }

        .flower-petal {
            fill: var(--color-primary);
            fill-opacity: 0.85;
        }

        .flower-expected {
            fill: none;
            stroke: var(--color-text-primary);
            stroke-width: 2;
        }

        .flower-label {
            font-size: 12px;
            fill: var(--color-text-secondary);
        }

        .flower-name {
            font-weight: 600;
            fill: var(--color-text-primary);
        }

        .profile {
            width: 100%;
            border-collapse: collapse;
            margin-top: 4px;
        }
        .profile th,
        .profile td {
            padding: 9px 8px;
            border-bottom: 1px solid var(--color-border-subtle);
            text-align: left;
            vertical-align: middle;
        }
        .profile thead th {
            font-size: 11.5px;
            font-weight: 600;
            color: var(--color-text-muted);
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .profile-name {
            width: 27%;
            font-weight: 600;
            color: var(--color-text-primary);
        }
        .profile-of {
            display: block;
            margin-top: 2px;
            font-weight: 400;
            font-size: 11.5px;
            color: var(--color-text-muted);
        }
        .profile-meter {
            width: 58%;
            white-space: nowrap;
        }
        .profile-expected {
            width: 15%;
            color: var(--color-text-secondary);
            font-variant-numeric: tabular-nums;
        }
        .meter {
            position: relative;
            display: inline-block;
            width: calc(100% - 52px);
            height: 10px;
            border-radius: 5px;
            background: var(--color-surface);
            border: 1px solid var(--color-border-subtle);
            vertical-align: middle;
        }
        .meter-fill {
            position: absolute;
            inset: 0 auto 0 0;
            border-radius: 5px;
            background: var(--color-primary);
        }
        /* The expectation, marked on the track rather than stated only in the
           cell, so an ordinary value reads as ordinary at a glance. */
        .meter-tick {
            position: absolute;
            top: -3px;
            bottom: -3px;
            width: 2px;
            margin-left: -1px;
            background: var(--color-text-secondary);
        }
        .profile-value {
            display: inline-block;
            width: 44px;
            margin-left: 8px;
            text-align: right;
            font-variant-numeric: tabular-nums;
            color: var(--color-text-primary);
            vertical-align: middle;
        }

        /* Body-text colour and size, not the muted footnote style: a caveat
           in small grey type under a table is the part a skimming reader skips. */
        .ranking-caveat {
            margin: 0 0 14px;
            color: var(--color-text-primary);
            font-size: 14px;
            line-height: 1.55;
            max-width: 72ch;
        }

        .chart-foot {
            margin: 10px 0 0;
            padding-top: 9px;
            border-top: 1px solid var(--color-border-subtle);
            color: var(--color-text-muted);
            font-size: 11.5px;
            line-height: 1.55;
        }

        /* The report is read on screen and printed to PDF. Splitting a chart
           or a table across a page break loses the axis with it. */
        /* Plotly shows its toolbar permanently on a device that cannot hover,
           where it covered legends and labels. Zoom and pan still work by
           touch, and the toolbar remains on hover everywhere else. */
        @media (hover: none) {
            .modebar-container {
                display: none !important;
            }
        }

        @media print {
            /* Browsers do not print background colours by default, but they
               do print text colour. A reader who had ever pressed "Dark
               Mode" printed #e6edf3 on white paper: 1.18:1, an effectively
               blank page. The theme persists in localStorage, so it
               survived a reload and every later report. Print is always
               the light palette. */
            :root,
            [data-theme="dark"] {
                --color-bg:             #ffffff;
                --color-surface:        #f6f8fa;
                --color-surface-raised: #ffffff;
                --color-border:         #d1d9e0;
                --color-border-subtle:  #eaeef2;
                --color-text-primary:   #1c2128;
                --color-text-secondary: #57606a;
                --color-text-muted:     #5c636b;
                --color-primary:        #1e40af;
                --color-accent:         #2563eb;
                --color-positive:       #1a7f37;
                --color-negative:       #cf222e;
            }

            /* Controls that cannot be operated on paper, advertising views
               the reader cannot reach. */
            .theme-toggle,
            .heatmap-controls,
            .modebar {
                display: none !important;
            }

            /* A chart is kept whole; a section is not. Keeping every
               section whole pushed each one to a new page, nine pages with
               the last holding only the footer. A heading stays with what
               follows it, and a table breaks between rows. */
            .chart-container,
            .stat-card,
            .ranking-table tr {
                break-inside: avoid;
                page-break-inside: avoid;
            }

            .section-title,
            .section-note {
                break-after: avoid;
                page-break-after: avoid;
            }

            /* Paper cannot scroll. The scroll container clipped the table's
               last columns, and the heatmap's minimum width ran off the
               page. */
            /* !important throughout: these override screen rules that come
               later in the stylesheet, and at equal specificity the later
               rule wins. */
            .table-wrapper,
            .heatmap-scroll {
                overflow: visible !important;
            }

            #chart-heatmap {
                min-width: 0 !important;
            }

            .ranking-table {
                font-size: 10px !important;
            }

            .ranking-table th,
            .ranking-table td {
                padding: 6px 8px !important;
            }
        }

        .section-title {
            display: flex;
            align-items: baseline;
            gap: 10px;
            padding-bottom: 8px;
            margin-bottom: 20px;
            border-bottom: 1px solid var(--color-border);
            /* Was 10px uppercase, which made the document's structural
               landmarks its smallest text -- about 7.5pt in a printed PDF.
               Uppercase also removes the word-shape cues a reader uses to
               scan, so it is kept only for short labels where scanning is
               not the job. */
            font-size: 17px;
            font-weight: 600;
            letter-spacing: -0.01em;
            color: var(--color-text-primary);
        }

        .section-title-qualifier {
            font-size: 11px;
            font-weight: 400;
            text-transform: none;
            letter-spacing: 0;
            color: var(--color-text-muted);
        }

        /* ============================================================
           Chart Containers
           ============================================================ */
        /* Accessible-but-invisible text: read by screen readers, never
           painted. Uses the clip-path/1px technique rather than
           display:none or visibility:hidden, both of which remove the
           element from the accessibility tree entirely. */
        .visually-hidden {
            position: absolute;
            width: 1px;
            height: 1px;
            margin: -1px;
            padding: 0;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            clip-path: inset(50%);
            white-space: nowrap;
            border: 0;
        }

        /* WCAG 2.1 SC 2.3.3. Readers who experience motion sickness or
           vestibular disorders set this at the OS level; honour it by
           removing transitions rather than merely shortening them. */
        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                transition-duration: 0.01ms !important;
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                scroll-behavior: auto !important;
            }
        }

        .chart-container {
            padding: 16px 16px 8px;
            background: var(--color-surface-raised);
            border: 1px solid var(--color-border);
            border-radius: 6px;
        }

        .chart-label {
            margin-bottom: 10px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            color: var(--color-text-muted);
        }

        .chart-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .chart-row + .chart-row {
            margin-top: 16px;
        }

        .chart-empty {
            padding: 40px;
            text-align: center;
            font-size: 13px;
            font-style: italic;
            color: var(--color-text-muted);
        }

        /* ============================================================
           Ranking Table
           ============================================================ */
        .table-wrapper {
            border: 1px solid var(--color-border);
            border-radius: 6px;
            overflow-x: auto;
        }

        .ranking-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
            font-variant-numeric: tabular-nums;
        }

        .ranking-table thead tr {
            background: var(--color-surface);
        }

        .ranking-table th {
            padding: 10px 14px;
            border-bottom: 2px solid var(--color-border);
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--color-text-muted);
            white-space: nowrap;
            text-align: left;
        }

        .ranking-table td {
            padding: 11px 14px;
            border-bottom: 1px solid var(--color-border-subtle);
            vertical-align: middle;
        }

        .ranking-table tbody tr:last-child td,
        .ranking-table tbody tr:last-child th {
            border-bottom: none;
        }

        .ranking-table tbody tr:hover td {
            background: var(--color-surface);
        }

        .rank-number {
            font-size: 12px;
            font-weight: 700;
            color: var(--color-text-muted);
        }

        .ranking-table th.row-header {
            padding: 11px 14px;
            border-bottom: 1px solid var(--color-border-subtle);
            font-size: 13px;
            font-weight: 400;
            text-transform: none;
            letter-spacing: normal;
            color: var(--color-text-primary);
            white-space: normal;
            vertical-align: middle;
        }

        /* A name or address with no spaces -- 257 characters is possible
           after the cap -- otherwise sets the column's minimum width and
           pushes every figure off the screen. `anywhere` rather than
           `break-word`: only `anywhere` lowers the minimum width that table
           layout reads. The cap on width keeps one long name from taking
           the table even when it could fit. */
        .contributor-name {
            display: block;
            max-width: 36ch;
            overflow-wrap: anywhere;
            font-weight: 600;
            color: var(--color-text-primary);
        }

        .contributor-email {
            display: block;
            max-width: 36ch;
            overflow-wrap: anywhere;
            margin-top: 2px;
            font-size: 11px;
            color: var(--color-text-muted);
        }

        /* ---- Tier Badges ---- */
        .tier-badge {
            display: inline-flex;
            align-items: center;
            padding: 3px 10px;
            border-radius: 3px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            line-height: 1.4;
            white-space: nowrap;
        }

        /* Tiers 3–7: solid filled */
        .tier-7 { background: var(--color-tier-7); color: var(--color-tier-ink); }
        .tier-6 { background: var(--color-tier-6); color: var(--color-tier-ink); }
        .tier-5 { background: var(--color-tier-5); color: var(--color-tier-ink); }
        .tier-4 { background: var(--color-tier-4); color: var(--color-tier-ink); }
        .tier-3 { background: var(--color-tier-3); color: var(--color-tier-ink); }

        /* Tiers 1–2: outlined — subdued to enforce visual hierarchy */
        .tier-2 {
            color: var(--color-tier-2);
            border: 1.5px solid var(--color-tier-2);
        }

        .tier-1 {
            color: var(--color-tier-1);
            border: 1.5px solid var(--color-tier-1);
        }

        /* ---- Numeric cells ---- */
        .num-positive { color: var(--color-positive); font-weight: 600; }
        .num-negative { color: var(--color-negative); font-weight: 600; }
        .num-neutral   { color: var(--color-text-secondary); }

        /* ---- Score bar ---- */
        .score-cell {
            display: flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

        .score-bar-track {
            width: 120px;
            height: 8px;
            flex-shrink: 0;
            background: var(--color-border);
            border-radius: 4px;
            overflow: hidden;
        }

        .score-bar-fill {
            height: 100%;
            border-radius: 4px;
            background: linear-gradient(
                to right,
                var(--color-primary),
                var(--color-accent)
            );
        }

        .score-text {
            font-size: 11px;
            font-weight: 600;
            font-variant-numeric: tabular-nums;
            color: var(--color-text-secondary);
        }

        /* ============================================================
           Footer
           ============================================================ */
        .report-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 56px;
            padding-top: 16px;
            border-top: 1px solid var(--color-border);
            font-size: 11px;
            letter-spacing: 0.2px;
            color: var(--color-text-muted);
        }

        /* ============================================================
           Responsive
           ============================================================ */
        @media (max-width: 900px) {
            .chart-row { grid-template-columns: 1fr; }
            .page { padding: 24px 20px 60px; }
            .report-header { flex-direction: column; gap: 12px; }
        }

        @media (max-width: 600px) {
            .summary-grid { grid-template-columns: repeat(2, 1fr); }
            .report-meta  { gap: 10px; }
        }

        /* ============================================================
           Heatmap Granularity Toolbar
           ============================================================ */
        .heatmap-controls {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }

        .heatmap-year-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        /* The grid is given a minimum width from its number of weeks and
           scrolls sideways below it. Squeezed to a phone's width it became a
           strip about 25 pixels tall. */
        .heatmap-scroll {
            overflow-x: auto;
        }

        .heatmap-year-btn {
            padding: 4px 12px;
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 4px;
            color: var(--color-text-secondary);
            font-family: inherit;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.6px;
            cursor: pointer;
            transition:
                background-color 0.15s ease,
                color 0.15s ease,
                border-color 0.15s ease;
        }

        .heatmap-year-btn:hover,
        .heatmap-year-btn.heatmap-year-active {
            background: var(--color-primary-dim);
            border-color: var(--color-primary);
            color: var(--color-primary);
        }

        .heatmap-contributor-select {
            padding: 4px 10px;
            background: var(--color-surface);
            border: 1px solid var(--color-border);
            border-radius: 4px;
            color: var(--color-text-secondary);
            font-family: inherit;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            min-width: 160px;
            transition:
                background-color 0.15s ease,
                border-color 0.15s ease;
        }

        .heatmap-contributor-select:hover {
            border-color: var(--color-primary);
        }
    </style>
</head>
<body>
<main class="page">

    <!-- ============================================================
         Header
         ============================================================ -->
    <header class="report-header">
        <div class="report-header-copy">
            <h1>{{ data.metadata.name }}</h1>
            <p class="report-subtitle">Repository History Report</p>
            <div class="report-meta">
                {% if data.metadata.remote_url %}
                <span><strong>Remote:</strong> {{ data.metadata.remote_url }}</span>
                {% endif %}
                {% if data.metadata.analysed_branch == 'HEAD' and data.provenance.head_sha %}
                {# A detached checkout has no branch; "HEAD" names none. #}
                <span><strong>Branch:</strong> detached HEAD at {{ data.provenance.head_sha[:7] }}</span>
                {% else %}
                <span><strong>Branch:</strong> {{ data.metadata.analysed_branch }}</span>
                {% endif %}
                <span>
                    <strong>Period:</strong>
                    {{ data.metadata.analysis_since }} to {{ data.metadata.analysis_until }}
                </span>
                <span><strong>Generated:</strong> {{ generated_at }}</span>
                {% if derived.contributors_below_threshold %}
                {#
                   Stated, not left to arithmetic. Without this line the table
                   listed some contributors while Total Commits counted all of
                   them, and the difference -- one suppressed contributor's
                   exact commit count -- was a subtraction away with nothing
                   saying why the numbers disagreed.
                #}
                <span class="filter-note">
                    <strong>Listing:</strong>
                    {{ data.metadata.unique_contributors }} of
                    {{ '{:,}'.format(derived.population_size) }} contributors.
                    {{ derived.contributors_below_threshold }}
                    {{ 'contributor is' if derived.contributors_below_threshold == 1 else 'contributors are' }}
                    below the min-commits threshold of
                    {{ data.provenance.min_commits }} and not listed; their commits
                    are still counted in every figure here.
                </span>
                {% endif %}
                {% if data.provenance.shallow_clone %}
                <span class="filter-note">
                    <strong>Shallow clone:</strong>
                    only the history this clone holds is analysed, and the
                    period starts where the clone's history does.
                </span>
                {% endif %}
                {% if data.provenance.commits_dated_after_window %}
                {#
                   A commit dated after the window is counted in no figure. The
                   branch therefore holds more commits than this report, and
                   the reader is told so rather than left to find the gap.
                #}
                <span class="filter-note">
                    <strong>Not counted:</strong>
                    {{ data.provenance.commits_dated_after_window }}
                    {{ 'commit' if data.provenance.commits_dated_after_window == 1 else 'commits' }}
                    dated after {{ data.metadata.analysis_until }}
                    {{ 'is' if data.provenance.commits_dated_after_window == 1 else 'are' }}
                    not counted.
                </span>
                {% endif %}
            </div>
        </div>
        <button id="theme-toggle" class="theme-toggle" type="button">
            Dark Mode
        </button>
    </header>

    <!-- ============================================================
         Summary Cards
         ============================================================ -->
    <div class="summary-grid">
        <div class="summary-card">
            <span class="visually-hidden">Total Commits: {{ '{:,}'.format(data.metadata.total_commits) }}</span>
            <div class="value" aria-hidden="true">{{ '{:,}'.format(data.metadata.total_commits) }}</div>
            <div class="label" aria-hidden="true">Total Commits</div>
        </div>
        <div class="summary-card">
            {#
               Everybody the figures describe, not the rows the threshold left
               in the table: with --min-commits 999 this card read 0 beside
               "1 hold half the commits". The header states the listing.
            #}
            <span class="visually-hidden">Contributors: {{ '{:,}'.format(derived.population_size) }}</span>
            <div class="value" aria-hidden="true">{{ '{:,}'.format(derived.population_size) }}</div>
            <div class="label" aria-hidden="true">Contributors</div>
        </div>
        <div class="summary-card">
            <span class="visually-hidden">Contributors holding half the commits: {{ '{:,}'.format(derived.commit_concentration) }}</span>
            <div class="value" aria-hidden="true">{{ '{:,}'.format(derived.commit_concentration) }}</div>
            <div class="label" aria-hidden="true">{{ 'Holds' if derived.commit_concentration == 1 else 'Hold' }} Half the Commits</div>
        </div>
        <div class="summary-card">
            <span class="visually-hidden">Longest quiet run between commits: {{ '{:,}'.format(derived.longest_inactive_streak) }} days</span>
            <div class="value" aria-hidden="true">{{ '{:,}'.format(derived.longest_inactive_streak) }}</div>
            <div class="label" aria-hidden="true">Longest Quiet Run (days)</div>
        </div>
        {#
           The fifth card describes the repository, never a person, in every
           mode. It once named an individual under "Top Contributor", and
           with --ranking it still put the top scorer's first name here, on
           the same page whose findings say no individual is named. A
           summary card is the first thing a reader looks at; a name there
           reads as the headline. The ranking table below carries the order
           for anyone who asked for it.
        #}
        <div class="summary-card">
            <span class="visually-hidden">
                Commit distribution, Gini coefficient:
                {{ '%.2f'|format(derived.gini_coefficient) }}
            </span>
            <div class="value" aria-hidden="true">{{ '%.2f'|format(derived.gini_coefficient) }}</div>
            <div class="label" aria-hidden="true">Distribution (Gini)</div>
        </div>
    </div>

    <!-- ============================================================
         What the history shows -- generated from the figures below
         ============================================================ -->
    {% if derived.findings %}
    <div class="section">
        <h2 class="section-title">What the History Shows</h2>
        <ul class="findings">
            {% for finding in derived.findings %}
            <li>
                <span class="finding-head">{{ finding.headline }}</span>
                <span class="finding-evidence">{{ finding.evidence }}</span>
                {% if finding.detail %}<span class="finding-detail">{{ finding.detail }}</span>{% endif %}
            </li>
            {% endfor %}
        </ul>
        <p class="chart-foot">
            Generated from the figures in this report by fixed rules, offline
            and without a language model. The same history always produces the
            same sentences. These sentences name no individual.
        </p>
    </div>
    {% endif %}
    <!-- ============================================================
         Contribution Distribution (Lorenz curve)
         ============================================================ -->
    <div class="section">
        <h2 class="section-title">Contribution Distribution<span class="section-metric">Gini <b>{{ '%.2f'|format(derived.gini_coefficient) }}</b></span></h2>
        <p class="section-note">
            Cumulative share of commits against cumulative share of
            contributors. The further the curve bows below the diagonal, the
            more concentrated the activity.
        </p>
        <div class="chart-container">
            <div id="chart-lorenz" role="img" aria-label="Lorenz curve showing the cumulative share of commits held by the cumulative share of contributors, plotted against a line of perfect equality. The same figures follow as a table."></div>
{{ chart_table("lorenz", "Cumulative share of commits against cumulative share of contributors") }}
        </div>
        <p class="chart-foot">
            {% if derived.population_size > 1 %}
            Gini runs 0 (even) to {{ derived.gini_ceiling }}, which is the most
            concentrated {{ '{:,}'.format(derived.population_size) }} contributors can be — the maximum is (n-1)/n, not 1.
            {% else %}
            With a single contributor there is no distribution to measure: the Gini is 0 by
            definition, not because activity is evenly shared.
            {% endif %}
            It describes the
            repository, not the people in it: a single maintainer with
            occasional contributors scores high for ordinary reasons.
            Comparable against this repository over time, not against another.
        </p>
    </div>
    <!-- ============================================================
         Activity Heatmap
         ============================================================ -->
    <div class="section">
        <h2 class="section-title">Commit Activity Heatmap</h2>
        <div class="heatmap-controls">
            <div id="heatmap-year-tabs" class="heatmap-year-tabs"
                 role="group" aria-label="Select calendar year for the heatmap"></div>
            <select id="heatmap-contributor-select"
                    class="heatmap-contributor-select"
                    aria-label="Filter the activity heatmap by contributor"></select>
        </div>
        <div class="chart-container heatmap-scroll">
            <div id="chart-heatmap" role="img" aria-label="Activity heatmap: commit counts per calendar day. {{ derived.heatmap_summary }}"></div>
        </div>
    </div>

    <!-- ============================================================
         Commit Timeline
         ============================================================ -->
    <div class="section">
        <h2 class="section-title">Weekly Commit Timeline</h2>
        <div class="chart-container">
            <div id="chart-timeline" role="img" aria-label="Line chart of total commits per calendar week across the analysis window. The same figures follow as a table."></div>
{{ chart_table("timeline", "Commits per week") }}
        </div>
    </div>

    <!-- ============================================================
         Repository profile
         ============================================================ -->
    {#
       A table, not a chart. It was a Plotly radar until 0.9.0: area is read
       far less accurately than length (Cleveland & McGill, JASA 1984), the
       shape depended on an axis order carrying no meaning, and the report had
       to instruct the reader to treat the figure as numbers rather than as a
       silhouette -- an admission that the form was wrong, not a mitigation of
       it. Numbers presented accurately is a table with bars in it. Two of the
       five measures were dropped because each restated a figure printed
       elsewhere in this report; see ADR 0012.

       Consequences, all deliberate: it renders with JavaScript off, where the
       radar drew nothing; it is visible to sighted readers, where the radar's
       figures lived only in a visually-hidden table; and it needs no
       role="img" and no aria-label, because it is text.

       A Jinja comment rather than an HTML one: this is for whoever edits the
       template, and has no business shipping inside every report.
    #}
    {% if profile %}
    <div class="section">
        <h2 class="section-title">Repository Profile</h2>
        <p class="section-note">
            Six shares of the analysis window, each from 0% to 100%.
        </p>
        {#
           The shape, as separate petals (ADR 0016): length is the share,
           centre 0% to rim 100%, never joined into a polygon whose area would
           depend on the axis order. Inline SVG coloured from the theme, so it
           renders without JavaScript and prints. The table below holds every
           figure as text; the label here repeats them for screen readers.
        #}
        {% if flower %}
        <figure class="profile-flower">
            <svg viewBox="0 0 440 440" role="img"
                 aria-label="Repository profile: {% for p in flower %}{{ p.name }} {{ p.percent }}{% if not loop.last %}, {% endif %}{% endfor %}. The figures follow in the table.">
                <circle class="flower-grid" cx="220" cy="220" r="60"></circle>
                <circle class="flower-grid" cx="220" cy="220" r="120"></circle>
                {% for p in flower %}
                <path class="flower-track" d="{{ p.track }}"></path>
                {% if p.petal %}<path class="flower-petal" d="{{ p.petal }}"></path>{% endif %}
                {% if p.expected %}<path class="flower-expected" d="{{ p.expected }}"></path>{% endif %}
                <text class="flower-label" x="{{ p.label_x }}" y="{{ p.label_y }}" text-anchor="{{ p.anchor }}">
                    <tspan class="flower-name">{{ p.name }}</tspan>
                    <tspan class="flower-value" x="{{ p.label_x }}" dy="15">{{ p.percent }}</tspan>
                </text>
                {% endfor %}
            </svg>
            <figcaption>Petal length is the share; a cross-line marks the value expected by chance.</figcaption>
        </figure>
        {% endif %}
        <table class="profile">
            <caption class="visually-hidden">
                The six repository profile measures, each with its value and,
                where one can be computed, the value expected under evenly
                spread activity.
            </caption>
            <thead>
                <tr>
                    <th scope="col">Measure</th>
                    <th scope="col">Share</th>
                    <th scope="col">Expected by chance</th>
                </tr>
            </thead>
            <tbody>
                {% for axis in profile %}
                <tr>
                    <th scope="row" class="profile-name">
                        {{ axis.name }}
                        <span class="profile-of">{{ axis.description }}</span>
                    </th>
                    <td class="profile-meter">
                        {#
                           The bar is decorative: every figure it encodes is in
                           the two cells beside it, so it carries aria-hidden
                           rather than a label that would be read twice.
                        #}
                        <span class="meter" aria-hidden="true">
                            <span class="meter-fill" style="width: {{ '%.1f'|format(axis.value * 100) }}%"></span>
                            {% if axis.expected is not none %}
                            <span class="meter-tick" style="left: {{ '%.1f'|format(axis.expected * 100) }}%"></span>
                            {% endif %}
                        </span>
                        <span class="profile-value">{{ '%.0f'|format(axis.value * 100) }}%</span>
                    </td>
                    <td class="profile-expected">
                        {% if axis.expected is not none %}
                        {{ '%.0f'|format(axis.expected * 100) }}%
                        {% else %}
                        <span aria-label="no expected value">&#8212;</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        <p class="chart-foot">
            <strong>Expected</strong> is what evenly spread activity would give,
            computed where the measure allows; it is not a target.
            None of these is a goal, and none describes a person.
        </p>
    </div>
    {% endif %}


    <!-- ============================================================
         Commit Size Distribution
         ============================================================ -->
    <div class="section">
        <h2 class="section-title">Change Size per Commit</h2>
        <p class="section-note">
            The size of a typical change, and how far the tail runs.
            Buckets double in width at each step, because the distribution is
            heavily skewed — on linear bins almost every commit lands in the
            first bar.
        </p>
        <div class="chart-container">
            <div id="chart-commit_size" role="img" aria-label="Histogram of commits grouped by the number of lines changed in each, on a log-spaced scale. The same figures follow as a table."></div>
{{ chart_table("commit_size", "Commits grouped by the number of lines each changed") }}
        </div>
        <p class="chart-foot">
            Churn is added plus deleted, not net: a commit that removes five
            hundred lines is a large change. Relative code churn in the sense
            of Nagappan &amp; Ball (ICSE 2005). Because the bins widen, the
            tallest bar is not the median — the median is marked. Describes the
            working rhythm of the repository and separates no contributor out.
        </p>
    </div>

    <!-- ============================================================
         Where the change lands -- files, not people
         ============================================================ -->
    {% if charts.hotspots != 'null' %}
    <div class="section">
        <h2 class="section-title">Where Change Concentrates</h2>
        <p class="section-note">
            Paths absorbing the most change, pooled across everyone.
        </p>
        <div class="chart-container">
            <div id="chart-hotspots" role="img" aria-label="Horizontal bar chart of the file paths with the most lines changed across the analysis window. The same figures follow as a table."></div>
{{ chart_table("hotspots", "Files by total lines changed") }}
        </div>
        <p class="chart-foot">
            Churn is added plus deleted, not net. This is the churn axis of
            hotspot analysis (Tornhill, 2013; Nagappan &amp; Ball, ICSE 2005) —
            Reveille reads history and never file content, so it cannot cross
            churn with complexity. A file that changes often is one to look
            at, not one that is wrong. Machine-generated files such as lock
            files are excluded; they dominate any churn ranking and tell you
            nothing you can act on.
        </p>
    </div>

    <div class="section">
        <h2 class="section-title">Change by File Type</h2>
        <p class="section-note">
            What kind of work the window contained.
        </p>
        <div class="chart-container">
            <div id="chart-extensions" role="img" aria-label="Bar chart of lines changed grouped by file extension. The same figures follow as a table."></div>
{{ chart_table("extensions", "Lines changed by file type") }}
        </div>
        <p class="chart-foot">
            Extensions beyond the largest eight are pooled rather than dropped,
            so the total is preserved. Files without an extension, including
            dotfiles, are reported together.
        </p>
    </div>
    {% endif %}

    <!-- ============================================================
         Per-Contributor Commit Frequency
         ============================================================ -->
    <div class="section">
        <h2 class="section-title">Per-Contributor Commit Frequency</h2>
        <div class="chart-container">
            <div id="chart-contributor_timeline" role="img" aria-label="Line chart of commits per calendar week, one line per contributor. The same figures follow as a table."></div>
{{ chart_table("contributor_timeline", "Commits per week, per contributor") }}
        </div>
    </div>

    {#
       Who changed each area (ADR 0013). Only with --area-authors: it names
       people, organised by directory rather than by person. Alphabetical
       names, one date per area, no count per person. Not part of the
       findings, which keep their promise to name nobody.
    #}
    {% if derived.areas %}
    <div class="section">
        <h2 class="section-title">Who Changed Each Area</h2>
        <p class="section-note">
            The {{ derived.areas|length }} most-changed directories in this
            window, up to {{ data.provenance.area_depth }} {{ 'level' if data.provenance.area_depth == 1 else 'levels' }} deep, and who
            changed them. It says who changed each area, not who knows or owns
            it: review and pairing do not appear in commit history.
        </p>
        <ul class="findings areas">
            {% for area in derived.areas %}
            <li>
                <span class="finding-head"><code>{{ area.area }}</code>: {{ area.headline }}</span>
                <span class="finding-evidence">{{ area.evidence }}</span>
                {% if area.authors %}<span class="finding-detail">{{ area.authors }}</span>{% endif %}
                {% if area.automated %}<span class="finding-detail">{{ area.automated }}</span>{% endif %}
                {% for note in area.notes %}<span class="finding-detail">{{ note }}</span>{% endfor %}
            </li>
            {% endfor %}
        </ul>
        <p class="chart-foot">
            Generated by fixed rules from the commits in this window. Names are
            listed alphabetically, not by activity. Identities whose name or
            address carries the [bot] suffix are listed as automated. One person with several addresses
            appears once per address; a .mailmap joins them.
        </p>
    </div>
    {% endif %}
    <!-- ============================================================
         Contributor table. Headed, columned and captioned as a ranking only
         when the ranking is enabled; see ADR 0010. The placeholder rows exist
         either way, so `data.ranked_contributors` is not the gate --
         `data.provenance.ranking_enabled` is.
         ============================================================ -->
    {% set ranked = data.provenance.ranking_enabled %}
    {% if data.ranked_contributors %}
    <div class="section">
        <h2 class="section-title">{% if ranked %}Contributor Rankings{% else %}Contributors{% endif %}</h2>
        {% if ranked %}
        {% set w = data.provenance.ranking_weights %}
        <p class="ranking-caveat">
            Contributors are ordered by a weighted score: commit count
            {{ (w.commits * 100)|round|int }}%, lines changed
            {{ (w.lines * 100)|round|int }}%, days with a commit
            {{ (w.consistency * 100)|round|int }}% and recency
            {{ (w.recency * 100)|round|int }}%. The score measures how much and how
            regularly each person committed in this window. It does not measure
            contribution, productivity or value, and it is not fit for judging
            individuals. The weights are a stated choice, not a validated model.
        </p>
        {% endif %}
        <div class="table-wrapper">
            <table class="ranking-table">
                <caption class="visually-hidden">
                    {% if ranked %}Contributor rankings{% else %}Contributors{% endif %} for {{ data.metadata.name }} between
                    {{ data.metadata.analysis_since }} and {{ data.metadata.analysis_until }}.
                    One row per contributor, ordered by {% if ranked %}composite score{% else %}commit count{% endif %}.
                    This table carries the same underlying data as the charts on
                    this page.
                </caption>
                <thead>
                    <tr>
                        {% if ranked %}
                        <th scope="col" style="text-align:center; width:44px">#</th>
                        {% endif %}
                        <th scope="col" style="min-width:160px">Contributor</th>
                        {% if ranked %}
                        <th scope="col" style="min-width:140px">Designation</th>
                        {% endif %}
                        <th scope="col" style="text-align:right">Commits</th>
                        <th scope="col" style="text-align:right">Lines Added</th>
                        <th scope="col" style="text-align:right">Lines Deleted</th>
                        <th scope="col" style="text-align:right">Net Lines</th>
                        <th scope="col" style="text-align:right">Active Days</th>
                        <th scope="col" style="white-space:nowrap">Last Commit</th>
                        {% if derived.co_authored_any %}
                        <th scope="col" style="text-align:right">Co-authored</th>
                        {% endif %}
                        {% if ranked %}
                        <th scope="col" style="min-width:180px">Score</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for contributor in data.ranked_contributors %}
                    <tr>
                        {% if ranked %}
                        <th scope="row" class="rank-number" style="text-align:center">
                            {{ loop.index }}
                        </th>
                        {% endif %}
                        <{% if ranked %}td{% else %}th scope="row" class="row-header"{% endif %}>
                            <span class="contributor-name">
                                {{ contributor.stats.name }}
                            </span>
                            <span class="contributor-email">
                                {{ contributor.stats.email }}
                            </span>
                        </{% if ranked %}td{% else %}th{% endif %}>
                        {% if ranked %}
                        <td>
                            <span class="tier-badge tier-{{ contributor.tier }}">
                                {{ contributor.tier_designation }}
                            </span>
                        </td>
                        {% endif %}
                        <td style="text-align:right">
                            {{ "{:,}".format(contributor.stats.commit_count) }}
                        </td>
                        <td style="text-align:right" class="num-positive">
                            +{{ "{:,}".format(contributor.stats.lines_added) }}
                        </td>
                        <td style="text-align:right" class="num-negative">
                            &#8722;{{ "{:,}".format(contributor.stats.lines_deleted) }}
                        </td>
                        <td style="text-align:right">
                            {% if contributor.stats.net_lines >= 0 %}
                                <span class="num-positive">
                                    +{{ "{:,}".format(contributor.stats.net_lines) }}
                                </span>
                            {% else %}
                                <span class="num-negative">
                                    {{ "{:,}".format(contributor.stats.net_lines) }}
                                </span>
                            {% endif %}
                        </td>
                        <td style="text-align:right" class="num-neutral">
                            {{ contributor.stats.active_days }}
                        </td>
                        <td style="color:var(--color-text-secondary)">
                            {{ contributor.stats.last_commit_date }}
                        </td>
                        {% if derived.co_authored_any %}
                        <td style="text-align:right" class="num-neutral">
                            {{ '{:,}'.format(contributor.stats.co_authored_commits) }}
                        </td>
                        {% endif %}
                        {% if ranked %}
                        <td>
                            <div class="score-cell">
                                <div class="score-bar-track">
                                    <div class="score-bar-fill"
                                         style="width:{{ (contributor.composite_score * 100) | int }}%">
                                    </div>
                                </div>
                                <span class="score-text">
                                    {{ "%.3f" | format(contributor.composite_score) }}
                                </span>
                            </div>
                        </td>
                        {% endif %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {#
           Co-authorship beside authorship (ADR 0014): identities credited by a
           Co-authored-by trailer who authored nothing in the window. Never in
           the charts, which count authors.
        #}
        {% if derived.co_authors_named or derived.co_authors_unnamed %}
        <p class="section-note co-authors">
            <strong>Credited only as co-author:</strong>
            {% if derived.co_authors_named %}{% for c in derived.co_authors_named[:10] %}{{ c.name }} ({{ '{:,}'.format(c.co_authored_commits) }}){% if not loop.last %}, {% endif %}{% endfor %}{% if derived.co_authors_named|length > 10 %} and {{ derived.co_authors_named|length - 10 }} others{% endif %}.{% endif %}
            {% if derived.co_authors_unnamed %}{{ derived.co_authors_unnamed }} below --min-commits {{ 'is' if derived.co_authors_unnamed == 1 else 'are' }} not named.{% endif %}
            Co-authored-by trailers are not verified.
        </p>
        {% endif %}
    </div>
    {% endif %}

    <!-- ============================================================
         Contribution Breakdown
         ============================================================ -->
    <div class="section">
        <h2 class="section-title">Contribution Breakdown</h2>

        {#
           One chart per question, and the form chosen for the question.

           Commit share is part-of-whole, which is the one job a pie does
           well: "is this one person's repository, or a team's" is read
           off a single wedge. Exact counts are in the table above, so
           the pie is not asked to do the comparison a bar would do
           better (Cleveland & McGill, JASA 1984, rank position above
           angle). Slices are capped at the palette length with a
           residual, so it never degrades into unreadable slivers.

           Lines changed stays a grouped bar: added against deleted is
           two series, which a pie cannot show at all. Its share was
           dropped -- it duplicated the bar beside it, and a share of
           lines changed is the least meaningful share in the report.
        #}
        <div class="chart-row">
            <div class="chart-container">
                <p class="chart-label">Share of Commits</p>
                <div id="chart-pie_commits" role="img" aria-label="Donut chart of each contributor's share of total commits. Exact counts appear in the Commits column of the contributor table above."></div>
{{ chart_table("pie_commits", "Each contributor's share of commits") }}
            </div>
            <div class="chart-container">
                <p class="chart-label">Lines Changed by Contributor</p>
                <div id="chart-contributor_lines" role="img" aria-label="Grouped bar chart of lines added and lines deleted per contributor. The same figures appear in the Lines Added and Lines Deleted columns of the contributor table."></div>
{{ chart_table("contributor_lines", "Lines added and deleted, per contributor") }}
            </div>
        </div>
    </div>

    <!-- ============================================================
         Footer
         ============================================================ -->
    <footer class="report-footer">
        <span>Generated by Reveille</span>
        <span>
            {{ data.metadata.analysis_since }} to {{ data.metadata.analysis_until }}
        </span>
    </footer>

</main>

<!-- ================================================================
     Plotly JS bundle — self-contained, no CDN
     ================================================================ -->
<script>{{ plotly_js | safe }}</script>

<!-- ================================================================
     Chart specifications — Plotly JSON, rendered client-side.
     Each block is a serialised Plotly figure (data + layout).
     The value 'null' indicates insufficient data for that chart.
     ================================================================ -->
<script type="application/json" id="spec-timeline">
{{ charts.timeline | safe }}
</script>
<script type="application/json" id="spec-contributor_timeline">
{{ charts.contributor_timeline | safe }}
</script>
<script type="application/json" id="spec-lorenz">
{{ charts.lorenz | safe }}
</script>

<script type="application/json" id="spec-commit_size">
{{ charts.commit_size | safe }}
</script>

<script type="application/json" id="spec-hotspots">
{{ charts.hotspots | safe }}
</script>

<script type="application/json" id="spec-extensions">
{{ charts.extensions | safe }}
</script>


<script type="application/json" id="spec-heatmap">
{{ charts.heatmap | safe }}
</script>
<script type="application/json" id="spec-contributor_lines">
{{ charts.contributor_lines | safe }}
</script>
<script type="application/json" id="spec-pie_commits">
{{ charts.pie_commits | safe }}
</script>
<!-- ================================================================
     Theme manager and chart initialisation
     ================================================================ -->
<script>
(function () {
    'use strict';

    var THEME_KEY = 'reveille-theme';

    var CHART_IDS = [
        'timeline',
        'contributor_timeline',
        'contributor_lines',
        'pie_commits',
        'lorenz',
        'commit_size',
        'hotspots',
        'extensions'
    ];

    var PLOTLY_CONFIG = {
        responsive: true,
        // 'hover' rather than true: ten always-visible toolbars were
        // printed into every PDF export, advertising controls a reader
        // of paper cannot operate.
        displayModeBar: 'hover',
        displaylogo: false,
        modeBarButtonsToRemove: ['sendDataToCloud', 'editInChartStudio']
    };

    // Heatmap colour ramps, one per theme.
    //
    // A sequential ramp encodes magnitude, so a busier day must always read as
    // more prominent than a quieter one. A single ramp cannot do that on two
    // surfaces: the old fixed scale ended at #1e3a8a, which sits at 9.73:1
    // against the light plot background but only 1.67:1 against the dark one.
    // In dark mode the busiest days therefore faded into the background while
    // the quietest ones glowed -- the chart read backwards, and the effect was
    // strongest exactly where the data mattered most.
    //
    // Both ramps below are one hue, and both were checked so that contrast
    // against their own surface rises at every step:
    //   light  #f6f8fa : 1.66 -> 2.92 -> 4.85 -> 9.73
    //   dark   #161b22 : 1.67 -> 3.35 -> 5.57 -> 9.59
    // The first stop stays transparent so a day with no commits is the surface
    // itself rather than a colour meaning "zero".
    // Heatmap colour ramps, one per theme.
    //
    // A sequential ramp encodes magnitude, so a busier day must always read
    // as more prominent than a quieter one. A single ramp cannot do that on
    // two surfaces, and contrast has to rise at every step.
    //
    // The lowest non-zero step matters most and was the weakest: at 1.66:1
    // light and 1.67:1 dark, a day with one commit was barely separable
    // from a day with none -- and colour is the only encoding here, with no
    // hover in a printed PDF. Both ramps now start at or above the 3:1 that
    // WCAG 2.1 asks of a graphical object needed to understand the content.
    //
    //   light  #f6f8fa : 3.67 -> 5.44 -> 7.57 -> 10.86
    //   dark   #161b22 : 3.61 -> 5.22 -> 7.82 -> 11.41
    //
    // The first stop stays transparent, so a day with no commits is the
    // surface itself rather than a colour meaning "zero".
    var HEATMAP_SCALES = {
        light: [
            [0.0,   'rgba(0,0,0,0)'],
            [0.001, '#4f83c4'],
            [0.35,  '#2f66ad'],
            [0.70,  '#1d4f95'],
            [1.0,   '#12386e']
        ],
        dark: [
            [0.0,   'rgba(0,0,0,0)'],
            [0.001, '#3d6fd0'],
            [0.35,  '#5b8ce6'],
            [0.70,  '#83b0f5'],
            [1.0,   '#b6d4ff']
        ]
    };

    var THEME_LAYOUTS = {
        light: {
            paper_bgcolor: '#ffffff',
            plot_bgcolor:  '#f6f8fa',
            font:   { color: '#1c2128' },
            xaxis:  { gridcolor: '#e2e8f0', linecolor: '#d1d9e0',
                      zerolinecolor: '#d1d9e0', tickcolor: '#d1d9e0' },
            yaxis:  { gridcolor: '#e2e8f0', linecolor: '#d1d9e0',
                      zerolinecolor: '#d1d9e0', tickcolor: '#d1d9e0' },
            legend: { font: { color: '#1c2128' } },
            hoverlabel: {
                bgcolor:     '#ffffff',
                bordercolor: '#d1d9e0',
                font:        { color: '#1c2128' }
            },
            // Left to Plotly, these derive from paper_bgcolor: the icons are
            // drawn at 30% of a contrast colour and repainted at 70% on
            // hover. Pinning both ends the derivation, so the toolbar keeps
            // a fixed, checked contrast under either theme instead of one
            // computed from a background we change underneath it.
            // A polar plot does not inherit plot_bgcolor. Plotly defaults
            // polar.bgcolor to #fff, so the radar drew a white disc inside
            // a dark card -- the same class of defect the cartesian axes
            // were cleared of, living in the gap between two guards.
            polar: {
                bgcolor: '#f6f8fa',
                radialaxis:  { gridcolor: '#e2e8f0', linecolor: '#e2e8f0', color: '#1c2128' },
                angularaxis: { gridcolor: '#e2e8f0', linecolor: '#e2e8f0', color: '#1c2128' }
            },
            modebar: {
                bgcolor:     '#ffffff',
                color:       '#57606a',
                activecolor: '#1e40af'
            }
        },
        dark: {
            paper_bgcolor: '#21262d',
            plot_bgcolor:  '#161b22',
            font:   { color: '#e6edf3' },
            xaxis:  { gridcolor: '#30363d', linecolor: '#30363d',
                      zerolinecolor: '#30363d', tickcolor: '#30363d' },
            yaxis:  { gridcolor: '#30363d', linecolor: '#30363d',
                      zerolinecolor: '#30363d', tickcolor: '#30363d' },
            legend: { font: { color: '#e6edf3' } },
            hoverlabel: {
                bgcolor:     '#21262d',
                bordercolor: '#30363d',
                font:        { color: '#e6edf3' }
            },
            // A polar plot does not inherit plot_bgcolor. Plotly defaults
            // polar.bgcolor to #fff, so the radar drew a white disc inside
            // a dark card -- the same class of defect the cartesian axes
            // were cleared of, living in the gap between two guards.
            polar: {
                bgcolor: '#161b22',
                radialaxis:  { gridcolor: '#30363d', linecolor: '#30363d', color: '#e6edf3' },
                angularaxis: { gridcolor: '#30363d', linecolor: '#30363d', color: '#e6edf3' }
            },
            modebar: {
                bgcolor:     '#21262d',
                color:       '#8b949e',
                activecolor: '#58a6ff'
            }
        }
    };

    // Recursively merge the theme layout over a chart's own layout.
    //
    // Object.assign is shallow. Assigning { xaxis: { gridcolor } } over a
    // layout whose xaxis carries { type, tickangle, title } would replace
    // the axis wholesale and take the axis title with it.
    function mergeLayout(base, overlay) {
        var out = Object.assign({}, base);
        Object.keys(overlay).forEach(function (key) {
            var value = overlay[key];
            var target = out[key];
            if (value && typeof value === 'object' && !Array.isArray(value)) {
                out[key] = mergeLayout(
                    (target && typeof target === 'object' && !Array.isArray(target))
                        ? target
                        : {},
                    value
                );
            } else {
                out[key] = value;
            }
        });
        return out;
    }

    // Heatmap state — populated during DOMContentLoaded.
    var heatmapData = null;
    var currentYear = null;
    var currentContributor = '__aggregated__';
    // True while the page is being printed: charts take the light theme and
    // the printed width (see fitChartsTo).
    var printing = false;

    // ------------------------------------------------------------------
    // Theme persistence
    // ------------------------------------------------------------------

    function readTheme() {
        try { return localStorage.getItem(THEME_KEY) || 'light'; }
        catch (e) { return 'light'; }
    }

    function writeTheme(theme) {
        try { localStorage.setItem(THEME_KEY, theme); }
        catch (e) { /* localStorage unavailable — non-fatal */ }
    }

    // ------------------------------------------------------------------
    // Document theme
    // ------------------------------------------------------------------

    function applyThemeToDocument(theme) {
        document.documentElement.setAttribute('data-theme', theme);
        var btn = document.getElementById('theme-toggle');
        if (btn) btn.textContent = theme === 'dark' ? 'Light Mode' : 'Dark Mode';
    }

    // ------------------------------------------------------------------
    // Non-heatmap chart initialisation
    // ------------------------------------------------------------------

    function initChart(id, theme) {
        var specEl = document.getElementById('spec-' + id);
        var divEl  = document.getElementById('chart-' + id);
        if (!specEl || !divEl) return;

        var raw = specEl.textContent.trim();
        if (!raw || raw === 'null') {
            divEl.innerHTML =
                '<p class="chart-empty">Insufficient data for this view.</p>';
            return;
        }

        var spec;
        try { spec = JSON.parse(raw); }
        catch (e) {
            divEl.innerHTML =
                '<p class="chart-empty">Chart specification could not be parsed.</p>';
            return;
        }

        if (!spec || !spec.data || spec.data.length === 0) {
            divEl.innerHTML =
                '<p class="chart-empty">Insufficient data for this view.</p>';
            return;
        }

        var layout = mergeLayout(spec.layout || {}, THEME_LAYOUTS[theme]);
        if (printing) layout.width = divEl.clientWidth;
        if (divEl._fullLayout) {
            Plotly.react(divEl, spec.data, layout, PLOTLY_CONFIG);
        } else {
            Plotly.newPlot(divEl, spec.data, layout, PLOTLY_CONFIG);
        }
    }

    function initAllCharts(theme) {
        CHART_IDS.forEach(function (id) { initChart(id, theme); });
        initHeatmapControls(theme);
    }

    // ------------------------------------------------------------------
    // Heatmap: GitHub-style grid builder
    //
    // All date arithmetic uses UTC milliseconds to avoid DST anomalies.
    // The grid covers the part of the requested year that lies inside the
    // analysis window, from the Monday of its first week to the Sunday of
    // its last. Days outside the window are null -- drawn as no cell, with
    // no hover -- because they are not days with no commits: before the
    // window the repository may not have existed, and after it is the
    // future. They were once drawn as zero, the whole year round.
    // ------------------------------------------------------------------

    function buildYearGrid(year, counts, since, until) {
        function dayMs(iso) {
            var p = iso.split('-');
            return Date.UTC(+p[0], +p[1] - 1, +p[2]);
        }
        var firstMs = Math.max(Date.UTC(year, 0, 1), since ? dayMs(since) : -Infinity);
        var lastMs  = Math.min(Date.UTC(year, 11, 31), until ? dayMs(until) : Infinity);
        var jan1Ms  = firstMs;
        var dec31Ms = lastMs;

        // Convert JS Sunday=0 to Monday=0 day-of-week index.
        var jan1Dow  = (new Date(jan1Ms).getUTCDay() + 6) % 7;
        var dec31Dow = (new Date(dec31Ms).getUTCDay() + 6) % 7;

        var gridStartMs = jan1Ms  - jan1Dow  * 86400000;
        var gridEndMs   = dec31Ms + (6 - dec31Dow) * 86400000;

        // gridStart is always Monday, gridEnd always Sunday —
        // total days is always divisible by 7.
        var numWeeks = Math.round(
            (gridEndMs - gridStartMs) / 86400000 + 1
        ) / 7;

        var MONTHS = [
            'Jan','Feb','Mar','Apr','May','Jun',
            'Jul','Aug','Sep','Oct','Nov','Dec'
        ];
        var DAY_LABELS = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];

        var z = [], customdata = [], xLabels = [];
        for (var d = 0; d < 7; d++) { z.push([]); customdata.push([]); }

        for (var w = 0; w < numWeeks; w++) {
            var weekMonMs = gridStartMs + w * 7 * 86400000;
            var wm = new Date(weekMonMs);
            xLabels.push(
                MONTHS[wm.getUTCMonth()] + ' ' +
                String(wm.getUTCDate()).padStart(2, '0')
            );

            for (var d = 0; d < 7; d++) {
                var cellMs = weekMonMs + d * 86400000;
                var cd = new Date(cellMs);
                if (cellMs >= firstMs && cellMs <= lastMs) {
                    var mo = String(cd.getUTCMonth() + 1).padStart(2, '0');
                    var da = String(cd.getUTCDate()).padStart(2, '0');
                    var dateStr = year + '-' + mo + '-' + da;
                    z[d].push(counts[dateStr] || 0);
                    customdata[d].push(dateStr);
                } else {
                    // Outside the window: no cell and no hover.
                    z[d].push(null);
                    customdata[d].push('');
                }
            }
        }

        return { z: z, x: xLabels, y: DAY_LABELS, customdata: customdata };
    }

    // ------------------------------------------------------------------
    // Heatmap rendering
    // ------------------------------------------------------------------

    function renderHeatmap(year, email, theme) {
        var divEl = document.getElementById('chart-heatmap');
        if (!divEl || !heatmapData) return;

        var counts = heatmapData.daily_counts[email] || {};
        var grid   = buildYearGrid(year, counts, heatmapData.since, heatmapData.until);

        // About 14 pixels a week plus room for the day labels and colour
        // bar. Below this the container scrolls instead of the cells
        // shrinking to nothing.
        divEl.style.minWidth = (grid.x.length * 14 + 120) + 'px';

        // Compute the peak commit count across the current grid.
        // When a contributor has no activity in the selected year, every z
        // value is 0. Plotly's zauto collapses a flat-zero dataset to an
        // arbitrary scale centred at 0, mapping all cells to a non-transparent
        // colour. Anchoring zmin=0 and zmax=max(peak,1) ensures zero always
        // resolves to the transparent stop in the colorscale.
        var zPeak = 1;
        for (var ri = 0; ri < grid.z.length; ri++) {
            for (var ci = 0; ci < grid.z[ri].length; ci++) {
                if (grid.z[ri][ci] > zPeak) zPeak = grid.z[ri][ci];
            }
        }

        var trace = {
            type: 'heatmap',
            z: grid.z,
            x: grid.x,
            y: grid.y,
            customdata: grid.customdata,
            zauto: false,
            zmin: 0,
            zmax: zPeak,
            colorscale: HEATMAP_SCALES[theme],
            showscale: true,
            hovertemplate: '%{customdata}<br>Commits: %{z}<extra></extra>'
        };

        var layout = mergeLayout({
            font: {
                family: "-apple-system, BlinkMacSystemFont, 'Segoe UI', " +
                        "Roboto, 'Helvetica Neue', Arial, sans-serif",
                size: 12
            },
            margin:     { l: 60, r: 30, t: 40, b: 50 },
            // 'domain' on both axes: square cells shrink the plot area to the
            // weeks drawn. The default extends the x range instead, which
            // drew empty columns past the end of the window.
            xaxis:      { type: 'category', tickangle: -45, constrain: 'domain' },
            yaxis:      { autorange: 'reversed', scaleanchor: 'x',
                          constrain: 'domain' },
            showlegend: false,
            modebar:    { remove: ['logo'] },
            height:     260
        }, THEME_LAYOUTS[theme]);
        if (printing) layout.width = divEl.clientWidth;

        if (divEl._fullLayout) {
            Plotly.react(divEl, [trace], layout, PLOTLY_CONFIG);
        } else {
            Plotly.newPlot(divEl, [trace], layout, PLOTLY_CONFIG);
        }
    }

    // ------------------------------------------------------------------
    // Heatmap controls initialisation
    // ------------------------------------------------------------------

    function initHeatmapControls(theme) {
        var specEl = document.getElementById('spec-heatmap');
        if (!specEl) return;

        var raw = specEl.textContent.trim();
        if (!raw || raw === 'null') {
            var divEl = document.getElementById('chart-heatmap');
            if (divEl) divEl.innerHTML =
                '<p class="chart-empty">Insufficient data for this view.</p>';
            return;
        }

        try { heatmapData = JSON.parse(raw); }
        catch (e) { return; }

        var years        = heatmapData.years        || [];
        var contributors = heatmapData.contributors || [];

        // Default: most recent year, aggregated view.
        currentYear        = years[years.length - 1];
        currentContributor = '__aggregated__';

        // Build year tab buttons.
        var tabsEl = document.getElementById('heatmap-year-tabs');
        if (tabsEl) {
            tabsEl.innerHTML = '';
            years.forEach(function (yr) {
                var btn = document.createElement('button');
                btn.type      = 'button';
                btn.textContent = String(yr);
                btn.className = 'heatmap-year-btn' +
                    (yr === currentYear ? ' heatmap-year-active' : '');
                // Communicates the selected year to assistive technology,
                // which cannot infer it from the active-state class alone.
                btn.setAttribute('aria-pressed', yr === currentYear ? 'true' : 'false');
                btn.addEventListener('click', function () {
                    currentYear = yr;
                    tabsEl.querySelectorAll('.heatmap-year-btn')
                        .forEach(function (b) {
                            var selected = b.textContent === String(yr);
                            b.classList.toggle('heatmap-year-active', selected);
                            b.setAttribute('aria-pressed', selected ? 'true' : 'false');
                        });
                    renderHeatmap(currentYear, currentContributor, readTheme());
                });
                tabsEl.appendChild(btn);
            });
        }

        // Build contributor dropdown.
        var selectEl = document.getElementById('heatmap-contributor-select');
        if (selectEl) {
            if (contributors.length > 1) {
                selectEl.innerHTML = '';
                contributors.forEach(function (c) {
                    var opt       = document.createElement('option');
                    opt.value     = c.email;
                    opt.textContent = c.name;
                    selectEl.appendChild(opt);
                });
                selectEl.value = '__aggregated__';
                selectEl.style.display = '';
                selectEl.addEventListener('change', function () {
                    currentContributor = selectEl.value;
                    renderHeatmap(currentYear, currentContributor, readTheme());
                });
            } else {
                // Single contributor: dropdown provides no choice — hide it.
                selectEl.style.display = 'none';
            }
        }

        renderHeatmap(currentYear, currentContributor, theme);
    }

    // ------------------------------------------------------------------
    // Theme update for already-rendered charts
    // ------------------------------------------------------------------

    function applyThemeToCharts(theme) {
        // Re-plot through the same path the first render uses, rather than
        // Plotly.relayout. relayout would work -- it is the one entry point
        // that expands dotted attribute strings, which is why the toggle
        // appeared correct while the first paint was not -- but handing it a
        // nested object replaces the container it names, so a themed xaxis
        // would take the axis title with it. One path, one set of semantics.
        CHART_IDS.forEach(function (id) { initChart(id, theme); });
        // The heatmap needs a full re-render rather than a relayout. Its
        // colour ramp is theme-specific -- see HEATMAP_SCALES -- and a
        // colorscale lives on the trace, which Plotly.relayout does not touch.
        // Relayout alone would swap the background and leave a ramp built for
        // the other surface, which is the inverted-reading bug the two ramps
        // exist to prevent.
        var heatmapEl = document.getElementById('chart-heatmap');
        if (heatmapEl && heatmapEl._fullLayout && heatmapData) {
            renderHeatmap(currentYear, currentContributor, theme);
        }
    }

    // ------------------------------------------------------------------
    // Theme toggle
    // ------------------------------------------------------------------

    function toggleTheme() {
        var next = readTheme() === 'dark' ? 'light' : 'dark';
        applyThemeToDocument(next);
        writeTheme(next);
        applyThemeToCharts(next);
    }

    // ------------------------------------------------------------------
    // Boot
    // ------------------------------------------------------------------

    var initialTheme = readTheme();
    applyThemeToDocument(initialTheme);

    // Printing reflows the page to the paper's width without firing a resize
    // event, so every chart kept its screen width and was cut off at the
    // right edge. Plotly.Plots.resize redraws on a timer, after the page has
    // already been printed, and 'beforeprint' fires before the print styles
    // apply. So the charts are redrawn when the print media query starts to
    // match -- the containers then have their printed width -- through the
    // same path as the first paint, with that width set. The page prints in
    // the light palette whatever theme it is shown in, so the charts do too;
    // they kept a dark theme and printed as dark panels on white paper. On
    // return they are redrawn in the reader's theme, sized to the screen.
    function fitChartsTo(isPrinting) {
        printing = isPrinting;
        var theme = printing ? 'light' : readTheme();
        CHART_IDS.forEach(function (id) { initChart(id, theme); });
        if (heatmapData) renderHeatmap(currentYear, currentContributor, theme);
    }
    var printQuery = window.matchMedia ? window.matchMedia('print') : null;
    if (printQuery && printQuery.addEventListener) {
        printQuery.addEventListener('change', function (query) {
            fitChartsTo(query.matches);
        });
    }
    window.addEventListener('afterprint', function () { fitChartsTo(false); });

    document.addEventListener('DOMContentLoaded', function () {
        initAllCharts(initialTheme);
        var themeBtn = document.getElementById('theme-toggle');
        if (themeBtn) themeBtn.addEventListener('click', toggleTheme);
    });

}());
</script>

</body>
</html>
