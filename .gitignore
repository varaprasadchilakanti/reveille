# ==================================================================
# Reveille -- Git Repository Intelligence
# .gitignore scoped to a Python CLI project using Poetry
# ==================================================================


# ------------------------------------------------------------------
# PYTHON RUNTIME
# ------------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
cython_debug/


# ------------------------------------------------------------------
# DISTRIBUTION & PACKAGING
# ------------------------------------------------------------------

build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.whl
*.tar.gz
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
.pybuilder/
target/


# ------------------------------------------------------------------
# VIRTUAL ENVIRONMENTS
# ------------------------------------------------------------------

.venv/
venv/
ENV/
env/
env.bak/
venv.bak/


# ------------------------------------------------------------------
# POETRY
#
# poetry.lock is intentionally tracked in version control.
# It guarantees reproducible installs for all contributors and CI.
# Omitting it means every fresh install resolves to different patch
# versions, which breaks the reproducibility guarantee.
#
# Reference:
#   https://python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
# ------------------------------------------------------------------

poetry.toml


# ------------------------------------------------------------------
# OTHER PACKAGE MANAGERS
# Patterns retained to prevent accidental commits if tooling changes.
# ------------------------------------------------------------------

Pipfile.lock
.pdm-python
.pdm-build/
__pypackages__/
.pixi/


# ------------------------------------------------------------------
# ENVIRONMENT & CONFIGURATION
# ------------------------------------------------------------------

.env
.env.*
!.env.example
.envrc
.flaskenv


# ------------------------------------------------------------------
# TESTING & COVERAGE
# ------------------------------------------------------------------

.pytest_cache/
.cache/
.coverage
.coverage.*
.coverage_data/
htmlcov/
coverage.xml
*.cover
*.py.cover
cover/
nosetests.xml
.hypothesis/
.tox/
.nox/


# ------------------------------------------------------------------
# TYPE CHECKING & LINTING
# ------------------------------------------------------------------

.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/


# ------------------------------------------------------------------
# TOOLING & RUNTIME ARTEFACTS
# ------------------------------------------------------------------

# PyPI credentials -- should never be committed
.pypirc

# Temporary code runner files (VS Code Code Runner extension)
tempCodeRunnerFile.py

# Jupyter
.ipynb_checkpoints/
profile_default/
ipython_config.py

# Abstra automation framework
.abstra/

# Rope refactoring tool
.ropeproject

# Spyder IDE
.spyderproject
.spyproject


# ------------------------------------------------------------------
# IDEs & EDITORS
# ------------------------------------------------------------------

.vscode/
.idea/
*.iml
*.swp
*.swo
*~


# ------------------------------------------------------------------
# OPERATING SYSTEM
# ------------------------------------------------------------------

# macOS
.DS_Store
._*
.AppleDouble
.LSOverride

# Windows
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/


# ------------------------------------------------------------------
# DOCUMENTATION BUILD OUTPUT
# ------------------------------------------------------------------

docs/_build/
site/


# ------------------------------------------------------------------
# REVEILLE -- PROJECT SPECIFIC
#
# Ignore HTML reports generated locally during development or manual
# testing. These are tool outputs, not source artefacts. Any report
# used as a test fixture belongs under tests/fixtures/ and must be
# explicitly git-added to override this rule.
# ------------------------------------------------------------------

reveille-report.html
*.reveille.html
reports/

# Manual staging area for untracked files
notrack/

# ------------------------------------------------------------------
# TEMPORARY & BACKUP FILES
# ------------------------------------------------------------------

*.tmp
*.bak
*.orig
*.log
